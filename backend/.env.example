# ── QUERYSENTINEL Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to git.

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
ATLAS_CLIENT_ID=<service_account_client_id>
ATLAS_CLIENT_SECRET=<service_account_client_secret>
ATLAS_PROJECT_ID=<atlas_project_id>
ATLAS_CLUSTER_PROCESS_ID=<cluster0-shard-00-00.abc.mongodb.net:27017>

# ── Google / Gemini API ───────────────────────────────────────────────────────
# Engine for the hackathon submission: Google Gemini.
LLM_BACKEND=gemini

# Option A: single key (AI Studio free tier — 15 RPM, 1500 req/day)
GOOGLE_API_KEY=AIza...

# Option B: multiple keys for key rotation (RECOMMENDED for demo)
# Effective RPM = num_keys × 12. 4 keys = 48 RPM → ~6s pipeline.
# Get free keys at https://aistudio.google.com/apikey (one per Gmail account)
# GOOGLE_API_KEYS=AIza...,AIza...,AIza...,AIza...

GOOGLE_PROJECT_ID=<your_gcp_project_id>
GOOGLE_REGION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# ── Application ──────────────────────────────────────────────────────────────
APP_DB=querysentinel
SOURCE_DB=sample_mflix
# NOTE: 'sales' is in sample_supplies DB — watcher uses _COLLECTION_DB_OVERRIDE map
# to route it to the correct database automatically.
MONITORED_COLLECTIONS=movies,comments,users,sessions,sales
ANOMALY_THRESHOLD_Z=2.0
CRITICAL_THRESHOLD_Z=3.5
PORT=8000
